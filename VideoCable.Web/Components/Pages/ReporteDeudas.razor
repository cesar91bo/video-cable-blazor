@page "/reporte-deudas"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using VideoCable.Domain.Enums
@using VideoCable.Infrastructure.Data

@inject AppDbContext DbContext
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Reporte de deudas</PageTitle>

<div class="page-header no-print">
    <div>
        <h1>Reporte de deudas</h1>
        <p class="text-muted mb-0">Clientes con facturas pendientes o parciales.</p>
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-outline-primary" @onclick="CargarReporte">
            Actualizar
        </button>

        <button class="btn btn-outline-secondary" @onclick="ImprimirReporteActual" disabled="@cargando">
            Imprimir reporte
        </button>
    </div>
</div>

<div class="print-only reporte-print-header">
    <h2>Reporte de deudas</h2>
    <div>Clientes con facturas pendientes o parciales</div>
    <div>Estado: @GetNombreFiltroAntiguedad()</div>
    <div>Servicio: @GetNombreFiltroServicio()</div>
    <div>Fecha: @DateTime.Today.ToString("dd/MM/yyyy")</div>
</div>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger mt-3">@error</div>
}

<div class="card mt-4 no-print">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Buscar cliente</label>
                <input class="form-control"
                       placeholder="Nombre, código, documento o CUIT..."
                       value="@busqueda"
                       @oninput="OnBusquedaInput" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Orden</label>
                <select class="form-select" @bind="ordenReporte" @bind:after="CargarReporte">
                    <option value="deuda_desc">Mayor deuda primero</option>
                    <option value="nombre">Nombre</option>
                    <option value="cantidad_desc">Más facturas primero</option>
                    <option value="periodo_antiguo">Período más antiguo</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label">Estado deuda</label>
                <select class="form-select" @bind="filtroAntiguedad" @bind:after="CargarReporte">
                    <option value="todos">Todos</option>
                    <option value="normal">Normal</option>
                    <option value="atencion">Atención</option>
                    <option value="riesgo">Riesgo / Suspender</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Servicio</label>
                <select class="form-select" @bind="filtroServicio" @bind:after="CargarReporte">
                    <option value="">Todos los servicios</option>
                    <option value="@TipoServicio.Video">Cable</option>
                    <option value="@TipoServicio.Fibra">Fibra</option>
                    <option value="@TipoServicio.Internet">Internet</option>
                    <option value="@TipoServicio.InternetTv">Internet + TV</option>
                    <option value="@TipoServicio.Otro">Otro</option>
                </select>
            </div>

            <div class="col-md-2 d-flex align-items-end">
                <button class="btn btn-primary w-100" @onclick="CargarReporte">
                    Buscar
                </button>
            </div>
        </div>
        <div class="text-muted small mt-3">
            Cable: atención a los 2 meses, riesgo desde los 3.
            Internet, fibra o combo: atención al mes, riesgo desde los 2.
        </div>
    </div>
</div>

@if (cargando)
{
    <p class="mt-4">Cargando reporte...</p>
}
else
{
    <div class="row mt-4 g-3 no-print">
        <div class="col-md-3">
            <div class="dashboard-card">
                <div class="dashboard-label">Clientes con deuda</div>
                <div class="dashboard-value">@items.Count</div>
                <div class="dashboard-subtitle">Clientes listados</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="dashboard-card">
                <div class="dashboard-label">Deuda total</div>
                <div class="dashboard-value">@totalDeuda.ToString("C0")</div>
                <div class="dashboard-subtitle">Saldo pendiente</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="dashboard-card">
                <div class="dashboard-label">Facturas pendientes</div>
                <div class="dashboard-value">@totalFacturas</div>
                <div class="dashboard-subtitle">Pendientes o parciales</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="dashboard-card">
                <div class="dashboard-label">Promedio deuda</div>
                <div class="dashboard-value">@promedioDeuda.ToString("C0")</div>
                <div class="dashboard-subtitle">Por cliente</div>
            </div>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header">
            Clientes con deuda
        </div>

        <div class="table-responsive grid-scroll">
            <table class="table table-striped table-hover mb-0">
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Primer período adeudado</th>
                        <th class="text-center">Antigüedad</th>
                        <th class="text-center">Estado deuda</th>
                        <th class="text-end">Facturas</th>
                        <th class="text-end">Deuda</th>
                        <th class="text-end no-print">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        <tr class="@GetClaseFila(item)">
                            <td>
                                <div class="fw-semibold">@item.Nombre</div>
                                <div class="text-muted small">Código @item.Codigo</div>
                            </td>

                            <td>@item.PrimerPeriodo</td>

                            <td class="text-center">
                                <div>@item.MesesAdeudados mes/es</div>
                                <div class="text-muted small">@item.DetalleServicios</div>
                            </td>

                            <td class="text-center">
                                @if (item.EstadoDeuda == EstadoDeudaCliente.Riesgo)
                                {
                                    <span class="badge bg-danger">Riesgo / Suspender</span>
                                }
                                else if (item.EstadoDeuda == EstadoDeudaCliente.Atencion)
                                {
                                    <span class="badge bg-warning text-dark">Atención</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Normal</span>
                                }
                            </td>

                            <td class="text-end">@item.CantidadFacturas</td>
                            <td class="text-end fw-bold">@item.Deuda.ToString("C0")</td>

                            <td class="text-end no-print">
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => IrACobranza()">
                                    Ir a cobranza
                                </button>
                            </td>
                        </tr>
                    }

                    @if (!items.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-muted">
                                No hay clientes con deuda para los filtros seleccionados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private bool cargando = true;
    private string? error;
    private string? busqueda;
    private string ordenReporte = "deuda_desc";
    private string filtroAntiguedad = "todos";
    private TipoServicio? filtroServicio;

    private List<DeudaClienteItem> items = new();

    private decimal totalDeuda;
    private int totalFacturas;
    private decimal promedioDeuda;

    protected override async Task OnInitializedAsync()
    {
        await CargarReporte();
    }

    private async Task OnBusquedaInput(ChangeEventArgs e)
    {
        busqueda = e.Value?.ToString();

        if (string.IsNullOrWhiteSpace(busqueda) || busqueda.Trim().Length >= 3)
        {
            await CargarReporte();
        }
    }

    private async Task CargarReporte()
    {
        cargando = true;
        error = null;

        try
        {
            var facturas = await DbContext.Facturas
                .AsNoTracking()
                .Include(x => x.Cliente)
                .Include(x => x.Suscripcion)
                    .ThenInclude(x => x.ServicioPlan)
                .Include(x => x.PagoAplicaciones)
                .Where(x =>
                    x.EstadoCobranza == EstadoCobranzaFactura.Pendiente ||
                    x.EstadoCobranza == EstadoCobranzaFactura.Parcial)
                .ToListAsync();

            var query = facturas
                .Select(x => new
                {
                    Factura = x,
                    Pagado = x.PagoAplicaciones.Sum(p => p.MontoAplicado),
                    Saldo = x.Total - x.PagoAplicaciones.Sum(p => p.MontoAplicado)
                })
                .Where(x => x.Saldo > 0);

            // Filtrar las facturas antes de calcular deuda, períodos y estado.
            // Así, al elegir cable no se suma la deuda de internet del mismo cliente.
            if (filtroServicio.HasValue)
            {
                var tipoSeleccionado = filtroServicio.Value;
                query = query.Where(x => ObtenerTipoServicio(
                    x.Factura.ServicioTipoSnapshot,
                    x.Factura.Suscripcion.ServicioPlan.TipoServicio) == tipoSeleccionado);
            }

            if (!string.IsNullOrWhiteSpace(busqueda))
            {
                var texto = busqueda.Trim();

                query = query.Where(x =>
                    x.Factura.Cliente.Nombre.Contains(texto, StringComparison.OrdinalIgnoreCase) ||
                    x.Factura.Cliente.Codigo.ToString().Contains(texto) ||
                    (x.Factura.Cliente.NumeroDocumento != null && x.Factura.Cliente.NumeroDocumento.Contains(texto)) ||
                    (x.Factura.Cliente.Cuit != null && x.Factura.Cliente.Cuit.Contains(texto)));
            }

            items = query
                .GroupBy(x => x.Factura.ClienteId)
                .Select(g =>
                {
                    var primera = g
                        .OrderBy(x => x.Factura.PeriodoAnio)
                        .ThenBy(x => x.Factura.PeriodoMes)
                        .First();

                    var ultima = g
                        .OrderByDescending(x => x.Factura.PeriodoAnio)
                        .ThenByDescending(x => x.Factura.PeriodoMes)
                        .First();

                    var cliente = primera.Factura.Cliente;

                    var mesesAdeudados = g
                        .Select(x => new { x.Factura.PeriodoAnio, x.Factura.PeriodoMes })
                        .Distinct()
                        .Count();

                    // Cada tipo de servicio cuenta sus propios períodos pendientes.
                    // Dos facturas del mismo tipo y mes cuentan como un solo mes.
                    var deudasPorServicio = g
                        .GroupBy(x => ObtenerTipoServicio(x.Factura.ServicioTipoSnapshot,
                            x.Factura.Suscripcion.ServicioPlan.TipoServicio))
                        .Select(servicio =>
                        {
                            var meses = servicio
                                .Select(x => new { x.Factura.PeriodoAnio, x.Factura.PeriodoMes })
                                .Distinct()
                                .Count();

                            return new
                            {
                                Tipo = servicio.Key,
                                Meses = meses,
                                Estado = CalcularEstadoDeuda(servicio.Key, meses)
                            };
                        })
                        .ToList();

                    // El cliente muestra el estado más grave de sus servicios adeudados.
                    var estadoDeuda = deudasPorServicio.Any(x => x.Estado == EstadoDeudaCliente.Riesgo)
                        ? EstadoDeudaCliente.Riesgo
                        : deudasPorServicio.Any(x => x.Estado == EstadoDeudaCliente.Atencion)
                            ? EstadoDeudaCliente.Atencion
                            : EstadoDeudaCliente.Normal;

                    return new DeudaClienteItem
                    {
                        ClienteId = cliente.Id,
                        Codigo = cliente.Codigo,
                        Nombre = cliente.Nombre,
                        Telefono = cliente.Telefono,
                        Documento = !string.IsNullOrWhiteSpace(cliente.Cuit)
                            ? cliente.Cuit
                            : cliente.NumeroDocumento,
                        CantidadFacturas = g.Count(),
                        MesesAdeudados = mesesAdeudados,
                        EstadoDeuda = estadoDeuda,
                        DetalleServicios = string.Join(" · ", deudasPorServicio
                            .OrderBy(x => x.Tipo)
                            .Select(x => $"{GetNombreServicio(x.Tipo)}: {x.Meses} mes/es")),
                        Deuda = g.Sum(x => x.Saldo),
                        PrimerPeriodo = $"{primera.Factura.PeriodoMes:00}/{primera.Factura.PeriodoAnio}",
                        UltimoPeriodo = $"{ultima.Factura.PeriodoMes:00}/{ultima.Factura.PeriodoAnio}",
                        PrimerAnio = primera.Factura.PeriodoAnio,
                        PrimerMes = primera.Factura.PeriodoMes
                    };
                })
                .ToList();

            items = filtroAntiguedad switch
            {
                "normal" => items.Where(x => x.EstadoDeuda == EstadoDeudaCliente.Normal).ToList(),
                "atencion" => items.Where(x => x.EstadoDeuda == EstadoDeudaCliente.Atencion).ToList(),
                "riesgo" => items.Where(x => x.EstadoDeuda == EstadoDeudaCliente.Riesgo).ToList(),
                _ => items
            };

            items = ordenReporte switch
            {
                "nombre" => items.OrderBy(x => x.Nombre).ToList(),
                "cantidad_desc" => items.OrderByDescending(x => x.CantidadFacturas).ThenByDescending(x => x.Deuda).ToList(),
                "periodo_antiguo" => items.OrderBy(x => x.PrimerAnio).ThenBy(x => x.PrimerMes).ToList(),
                _ => items.OrderByDescending(x => x.Deuda).ToList()
            };

            totalDeuda = items.Sum(x => x.Deuda);
            totalFacturas = items.Sum(x => x.CantidadFacturas);
            promedioDeuda = items.Any() ? totalDeuda / items.Count : 0;
        }
        catch (Exception ex)
        {
            error = $"Error al cargar el reporte: {ex.Message}";
            Console.WriteLine(ex.ToString());
        }

        cargando = false;
    }

    private enum EstadoDeudaCliente
    {
        Normal,
        Atencion,
        Riesgo
    }

    private static TipoServicio ObtenerTipoServicio(string? snapshot, TipoServicio tipoActual)
    {
        // Usar el tipo facturado cuando el snapshot contiene el enum o su valor.
        if (Enum.TryParse<TipoServicio>(snapshot, true, out var tipo)
            && Enum.IsDefined(typeof(TipoServicio), tipo))
            return tipo;

        if (string.Equals(snapshot?.Trim(), "Internet + TV", StringComparison.OrdinalIgnoreCase))
            return TipoServicio.InternetTv;

        return tipoActual;
    }

    private static EstadoDeudaCliente CalcularEstadoDeuda(TipoServicio tipo, int meses)
    {
        var mesesParaRiesgo = tipo switch
        {
            TipoServicio.Fibra or TipoServicio.Internet or TipoServicio.InternetTv => 2,
            _ => 3
        };

        if (meses >= mesesParaRiesgo)
            return EstadoDeudaCliente.Riesgo;

        if (meses == mesesParaRiesgo - 1)
            return EstadoDeudaCliente.Atencion;

        return EstadoDeudaCliente.Normal;
    }

    private static string GetNombreServicio(TipoServicio tipo) => tipo switch
    {
        TipoServicio.Video => "Cable",
        TipoServicio.Fibra => "Fibra",
        TipoServicio.Internet => "Internet",
        TipoServicio.InternetTv => "Internet + TV",
        _ => "Otro"
    };

    private string GetClaseFila(DeudaClienteItem item)
    {
        if (item.EstadoDeuda == EstadoDeudaCliente.Riesgo)
            return "table-danger";

        if (item.EstadoDeuda == EstadoDeudaCliente.Atencion)
            return "table-warning";

        return "";
    }

    private void IrACobranza()
    {
        Navigation.NavigateTo("/cobranza");
    }

    private async Task ImprimirReporteActual()
    {
        if (cargando)
            return;

        await JSRuntime.InvokeVoidAsync("window.print");
    }


    private string GetNombreFiltroServicio()
    {
        return filtroServicio.HasValue
            ? GetNombreServicio(filtroServicio.Value)
            : "Todos los servicios";
    }

    private string GetNombreFiltroAntiguedad()
    {
        return filtroAntiguedad switch
        {
            "normal" => "Normal",
            "atencion" => "Atención",
            "riesgo" => "Riesgo / Suspender",
            _ => "Todos"
        };
    }

    private class DeudaClienteItem
    {
        public int ClienteId { get; set; }
        public int Codigo { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string? Telefono { get; set; }
        public string? Documento { get; set; }
        public int CantidadFacturas { get; set; }
        public int MesesAdeudados { get; set; }
        public EstadoDeudaCliente EstadoDeuda { get; set; }
        public string DetalleServicios { get; set; } = string.Empty;
        public decimal Deuda { get; set; }
        public string PrimerPeriodo { get; set; } = string.Empty;
        public string UltimoPeriodo { get; set; } = string.Empty;
        public int PrimerAnio { get; set; }
        public int PrimerMes { get; set; }
    }
}

<style>
    .dashboard-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 0.85rem;
        padding: 1.25rem;
        min-height: 120px;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08);
    }

    .dashboard-label {
        color: #6b7280;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04rem;
    }

    .dashboard-value {
        font-size: 1.75rem;
        font-weight: 700;
        margin-top: 0.35rem;
    }

    .dashboard-subtitle {
        color: #6b7280;
        font-size: 0.9rem;
        margin-top: 0.25rem;
    }

    .grid-scroll {
        max-height: 520px;
        overflow-y: auto;
    }

        .grid-scroll thead th {
            position: sticky;
            top: 0;
            z-index: 2;
            background: #f8f9fa;
        }

    .print-only {
        display: none;
    }

    @@media print {
        body {
            background: #ffffff !important;
        }

        .no-print,
        .sidebar,
        .top-row,
        .page-header,
        button {
            display: none !important;
        }

        .print-only {
            display: block !important;
        }

        .content {
            padding: 0 !important;
        }

        .card {
            border: none !important;
            box-shadow: none !important;
        }

        .card-header {
            font-size: 1.1rem;
            font-weight: 700;
            border-bottom: 1px solid #000 !important;
            background: #ffffff !important;
        }

        .grid-scroll {
            max-height: none !important;
            overflow: visible !important;
        }

            .grid-scroll thead th {
                position: static !important;
                background: #ffffff !important;
            }

        .reporte-print-header {
            margin-bottom: 1rem;
            border-bottom: 1px solid #000;
            padding-bottom: 0.75rem;
        }

            .reporte-print-header h2 {
                margin-bottom: 0.25rem;
            }

        table {
            font-size: 0.9rem;
        }

        .table-danger td {
            background-color: #f8d7da !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .table-warning td {
            background-color: #fff3cd !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .badge {
            border: 1px solid #000;
            color: #000 !important;
            background: transparent !important;
        }
    }
</style>